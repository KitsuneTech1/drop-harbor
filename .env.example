PORT=3000
HOST=0.0.0.0

# Max size of a single upload, in megabytes.
MAX_FILE_SIZE_MB=1024

# Required to upload or delete. Leave blank only if every person who can
# reach this server is allowed to fill its disk. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
UPLOAD_TOKEN=YOUR_TOKEN

# Lifetime applied when an upload does not pick one, in hours. 168 = 7 days.
DEFAULT_EXPIRY_HOURS=168

# Longest lifetime an upload may ask for, in hours. 8760 = 1 year.
MAX_EXPIRY_HOURS=8760

# How often expired files and orphans are swept off disk, in minutes.
SWEEP_INTERVAL_MINUTES=5
